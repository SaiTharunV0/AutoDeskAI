{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/api/:path*",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://autodeskai-backend.onrender.com/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://autodeskai-backend.onrender.com/:path*"
    }
  ]
}
